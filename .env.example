# Supabase Postgres. Use the *transaction pooler* URL (port 6543) for serverless.
# Leave empty locally to use the non-persistent in-memory store.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Auth. Set SUPABASE_JWT_SECRET for legacy HS256 projects;
# otherwise tokens are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated

# Comma-separated list of allowed browser origins
CORS_ORIGINS=https://wickbound.online,https://www.wickbound.online,http://localhost:3000,http://localhost:5500

# Anti-cheat / rate limits
MAX_SCORE=1000000
MAX_POINTS_PER_SECOND=500
MIN_DURATION_MS=1000
SCORE_SUBMISSIONS_PER_MINUTE=10
LEVEL_UPLOADS_PER_HOUR=5
